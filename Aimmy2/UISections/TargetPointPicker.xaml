<Window x:Class="UISections.TargetPointPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:Aimmy2.Theme"
        theme:ThemeBehavior.AutoRegister="True"
        Title="Target Point Picker"
        Height="480"
        Width="260"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Grid Margin="10,10,10,0">
        <Border x:Name="MainBorder"
                CornerRadius="8"
                BorderBrush="{DynamicResource ThemeColorDark}"
                BorderThickness="1"
                Padding="0"
                Background="#FF1A1A1A">
            <Grid Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Background="{DynamicResource ThemeColor}" MouseDown="Header_MouseDown">
                    <Border Padding="8" Background="Transparent" DockPanel.Dock="Left">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Fill="White"
                                  StrokeThickness="1.33333"
                                  Stretch="Fill"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Width="20"
                                  Height="10"
                                  Margin="0,0,8,0">
                                <Path.Data>
                                    <PathGeometry Figures="M 18.2472,490.72756 0.18686636,472.66723 153.0173,318.84293 305.84774,165.01862 l 17.74245,17.70593 17.74244,17.70592 17.0189,-16.98112 c 9.36039,-9.33961 17.60957,-16.98112 18.33151,-16.98112 0.72194,0 69.86022,68.54563 153.64061,152.32363 l 152.32798,152.32362 -18.32581,18.45368 -18.3258,18.45368 -152.3021,-153.11064 -152.3021,-153.11063 -20.36457,20.6423 C 309.83073,233.79713 241.18587,302.86906 168.4871,375.93703 L 36.307534,508.7879 Z"
                                  FillRule="NonZero" />
                                </Path.Data>
                            </Path>
                            <TextBlock Text="Target Point"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       FontFamily="Segoe UI"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="Exit"
                            Content="&#xE8BB;"
                            HorizontalAlignment="Right"
                            Background="{x:Null}"
                            BorderBrush="{x:Null}"
                            Foreground="White"
                            FontFamily="Segoe MDL2 Assets"
                            Padding="15,0,15,0"
                            materialDesign:ButtonAssist.CornerRadius="0,5,5,0"
                            BorderThickness="0,0,0,0"
                            FontSize="10"
                            VerticalAlignment="Center"
                            Click="Exit_Click" />
                </DockPanel>

                <StackPanel Grid.Row="1" Margin="15,15,15,0">
                    <TextBlock Text="Click a zone to set the aim point"
                               Foreground="#FFAAAAAA"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>

                    <!-- Player silhouette with overlaid clickable zones -->
                    <Grid Width="140" Height="260" HorizontalAlignment="Center">
                        <!-- Decorative silhouette (not hit-testable) - simple blocky figure -->
                        <Rectangle Width="36" Height="36" Fill="#FF3A3A3A"
                                   HorizontalAlignment="Center" VerticalAlignment="Top"
                                   IsHitTestVisible="False"/>
                        <Rectangle Width="80" Height="200" Fill="#FF3A3A3A"
                                   HorizontalAlignment="Center" VerticalAlignment="Top"
                                   Margin="0,40,0,0" IsHitTestVisible="False"/>
                        <Rectangle Width="18" Height="110" Fill="#FF3A3A3A"
                                   HorizontalAlignment="Left" VerticalAlignment="Top"
                                   Margin="12,50,0,0" IsHitTestVisible="False"/>
                        <Rectangle Width="18" Height="110" Fill="#FF3A3A3A"
                                   HorizontalAlignment="Right" VerticalAlignment="Top"
                                   Margin="0,50,12,0" IsHitTestVisible="False"/>

                        <!-- Clickable zones, top to bottom -->
                        <StackPanel>
                            <Border x:Name="ZoneHead" Height="48" Background="Transparent"
                                    MouseLeftButtonUp="Zone_Click" Tag="Head" Cursor="Hand">
                                <TextBlock Text="Head" Foreground="White" FontSize="11"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                            </Border>
                            <Border x:Name="ZoneNeck" Height="30" Background="Transparent"
                                    MouseLeftButtonUp="Zone_Click" Tag="Neck" Cursor="Hand">
                                <TextBlock Text="Neck" Foreground="White" FontSize="11"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                            </Border>
                            <Border x:Name="ZoneChest" Height="60" Background="Transparent"
                                    MouseLeftButtonUp="Zone_Click" Tag="Chest" Cursor="Hand">
                                <TextBlock Text="Chest" Foreground="White" FontSize="11"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                            </Border>
                            <Border x:Name="ZoneStomach" Height="60" Background="Transparent"
                                    MouseLeftButtonUp="Zone_Click" Tag="Stomach" Cursor="Hand">
                                <TextBlock Text="Stomach" Foreground="White" FontSize="11"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                            </Border>
                            <Border x:Name="ZoneLegs" Height="62" Background="Transparent"
                                    MouseLeftButtonUp="Zone_Click" Tag="Legs" Cursor="Hand">
                                <TextBlock Text="Legs" Foreground="White" FontSize="11"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Horizontal lean" Foreground="#FFAAAAAA" FontSize="11" Margin="0,16,0,6"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border x:Name="LeanLeft" Width="46" Height="32" Background="Transparent"
                                MouseLeftButtonUp="Lean_Click" Tag="25" Cursor="Hand"
                                BorderBrush="#FF3A3A3A" BorderThickness="1">
                            <TextBlock Text="Left" Foreground="White" FontSize="10"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </Border>
                        <Border x:Name="LeanCenter" Width="47" Height="32" Background="Transparent"
                                MouseLeftButtonUp="Lean_Click" Tag="50" Cursor="Hand"
                                BorderBrush="#FF3A3A3A" BorderThickness="1">
                            <TextBlock Text="Center" Foreground="White" FontSize="10"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </Border>
                        <Border x:Name="LeanRight" Width="46" Height="32" Background="Transparent"
                                MouseLeftButtonUp="Lean_Click" Tag="75" Cursor="Hand"
                                BorderBrush="#FF3A3A3A" BorderThickness="1">
                            <TextBlock Text="Right" Foreground="White" FontSize="10"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </Border>
                    </StackPanel>

                    <TextBlock x:Name="SelectionLabel" Text="Selected: Chest / Center"
                               Foreground="White" FontSize="11" FontWeight="Bold"
                               Margin="0,16,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
