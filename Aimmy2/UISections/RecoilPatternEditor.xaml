<Window x:Class="UISections.RecoilPatternEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:Aimmy2.Theme"
        theme:ThemeBehavior.AutoRegister="True"
        Title="Recoil Pattern Editor"
        Height="660"
        Width="320"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Window.Resources>
        <!-- Every TextBox/Button in this window was picking up invisible default
             system colors against the dark background - everything below is explicit
             so it's always readable. -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF262626"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="EditorButton" TargetType="Button">
            <Setter Property="Background" Value="#FF262626"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource EditorButton}">
            <Setter Property="Background" Value="{DynamicResource ThemeColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeColorDark}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource EditorButton}"/>
    </Window.Resources>
    <Grid Margin="10,10,10,0">
        <Border x:Name="MainBorder"
                CornerRadius="8"
                BorderBrush="{DynamicResource ThemeColorDark}"
                BorderThickness="1"
                Padding="0"
                Background="#FF1A1A1A">
            <Grid Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Background="{DynamicResource ThemeColor}" MouseDown="Header_MouseDown">
                    <Border Padding="8" Background="Transparent" DockPanel.Dock="Left">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Fill="White"
                                  StrokeThickness="1.33333"
                                  Stretch="Fill"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Width="20"
                                  Height="10"
                                  Margin="0,0,8,0">
                                <Path.Data>
                                    <PathGeometry Figures="M 18.2472,490.72756 0.18686636,472.66723 153.0173,318.84293 305.84774,165.01862 l 17.74245,17.70593 17.74244,17.70592 17.0189,-16.98112 c 9.36039,-9.33961 17.60957,-16.98112 18.33151,-16.98112 0.72194,0 69.86022,68.54563 153.64061,152.32363 l 152.32798,152.32362 -18.32581,18.45368 -18.3258,18.45368 -152.3021,-153.11064 -152.3021,-153.11063 -20.36457,20.6423 C 309.83073,233.79713 241.18587,302.86906 168.4871,375.93703 L 36.307534,508.7879 Z"
                                  FillRule="NonZero" />
                                </Path.Data>
                            </Path>
                            <TextBlock Text="Recoil Pattern Editor"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontSize="13"
                                       FontFamily="Segoe UI"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="Exit"
                            Content="&#xE8BB;"
                            HorizontalAlignment="Right"
                            Background="{x:Null}"
                            BorderBrush="{x:Null}"
                            Foreground="White"
                            FontFamily="Segoe MDL2 Assets"
                            Padding="15,0,15,0"
                            materialDesign:ButtonAssist.CornerRadius="0,5,5,0"
                            BorderThickness="0,0,0,0"
                            FontSize="10"
                            VerticalAlignment="Center"
                            Click="Exit_Click" />
                </DockPanel>

                <StackPanel Grid.Row="1" Margin="15,12,15,8">
                    <TextBlock Text="Pattern Name" Foreground="#FFAAAAAA" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox x:Name="PatternNameBox" FontSize="12" Padding="4" Margin="0,0,0,8"/>

                    <TextBlock Text="Fire Rate (RPM)" Foreground="#FFAAAAAA" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox x:Name="RpmBox" FontSize="12" Padding="4" Text="600"/>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="ModeListButton" Content="List" Padding="14,4" Margin="0,0,4,0" Click="ModeList_Click"/>
                        <Button x:Name="ModeDrawButton" Content="Draw" Padding="14,4" Margin="4,0,0,0" Click="ModeDraw_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="ListModeHint"
                               Text="Each row is one shot. Dx/Dy are pixels to pull the mouse to counter that shot's recoil (negative Dy = pull up)."
                               Foreground="#FF888888" FontSize="10" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    <TextBlock x:Name="DrawModeHint"
                               Text="Click and drag on the canvas below to trace the pull path, starting where you click, or load a photo of one (bright line on a plain dark background works best). Then Apply to turn it into shots."
                               Foreground="#FF888888" FontSize="10" TextWrapping="Wrap" Margin="0,10,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>

                <ScrollViewer x:Name="ListViewPanel" Grid.Row="2" Margin="15,0,15,0" VerticalScrollBarVisibility="Auto">
                    <ListBox x:Name="StepsList" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding ShotLabel}" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Margin="2,0" Padding="3" Text="{Binding Dx, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Column="2" Margin="2,0" Padding="3" Text="{Binding Dy, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Grid.Column="3" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                            Background="Transparent" BorderThickness="0" Foreground="#FFAAAAAA"
                                            Click="RemoveStep_Click" Tag="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>

                <Grid x:Name="DrawPanel" Grid.Row="2" Margin="15,0,15,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="#FF3A3A3A" BorderThickness="1" Background="#FF101010" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <Grid>
                            <!-- Faint reference grid so you can judge distance/proportion while dragging -->
                            <Canvas Width="260" Height="260" IsHitTestVisible="False">
                                <Line X1="65" Y1="0" X2="65" Y2="260" Stroke="#FF222222" StrokeThickness="1"/>
                                <Line X1="130" Y1="0" X2="130" Y2="260" Stroke="#FF2A2A2A" StrokeThickness="1"/>
                                <Line X1="195" Y1="0" X2="195" Y2="260" Stroke="#FF222222" StrokeThickness="1"/>
                                <Line X1="0" Y1="65" X2="260" Y2="65" Stroke="#FF222222" StrokeThickness="1"/>
                                <Line X1="0" Y1="130" X2="260" Y2="130" Stroke="#FF2A2A2A" StrokeThickness="1"/>
                                <Line X1="0" Y1="195" X2="260" Y2="195" Stroke="#FF222222" StrokeThickness="1"/>
                            </Canvas>
                            <Canvas x:Name="DrawCanvas" Width="260" Height="260" Background="Transparent" ClipToBounds="True" Cursor="Cross"
                                    MouseLeftButtonDown="DrawCanvas_MouseDown"
                                    MouseMove="DrawCanvas_MouseMove"
                                    MouseLeftButtonUp="DrawCanvas_MouseUp"
                                    MouseLeave="DrawCanvas_MouseLeave"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                        <TextBlock x:Name="DrawPointCountLabel" Text="Click and drag to start drawing."
                                   Foreground="#FF888888" FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="Shots to Generate" Foreground="#FFAAAAAA" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox x:Name="DrawShotCountBox" FontSize="12" Padding="4" Text="20"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Text="Pull Scale" Foreground="#FFAAAAAA" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox x:Name="DrawScaleBox" FontSize="12" Padding="4" Text="3"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Button x:Name="LoadImageButton" Content="Load Image..." Padding="10,4" Margin="4,0" Click="LoadImage_Click"/>
                            <Button x:Name="ClearDrawingButton" Content="Clear" Padding="10,4" Margin="4,0" Click="ClearDrawing_Click"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <Button x:Name="ApplyDrawingButton" Content="Apply to Shot List" Padding="10,4" Margin="4,0" Click="ApplyDrawing_Click" Style="{StaticResource PrimaryButton}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button x:Name="AddStepButton" Content="+ Add Shot" Padding="10,4" Margin="4,0" Click="AddStep_Click"/>
                    <Button x:Name="SaveButton" Content="Save" Padding="16,4" Margin="4,0" Click="Save_Click" Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
